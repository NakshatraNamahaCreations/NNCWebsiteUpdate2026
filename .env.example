# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored, so it must be created manually on each server.
# After changing it, restart the app (e.g. `pm2 restart all`) — Next.js only
# reads env vars at startup.

# ── SMTP (Hostinger) — enquiry notification + customer confirmation emails ──
# IMPORTANT: wrap the password in double quotes. A value containing '#' is
# otherwise truncated at the '#' (dotenv treats it as a comment), which makes
# the app authenticate with a wrong password and every email fails with
# "535 authentication failed" — while enquiries still reach the CRM, so the
# breakage is easy to miss.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@nakshatranamahacreations.com
SMTP_PASS="your-password-here"

# ── CRM backend ──
# MUST match the backend the admin CRM reads from, otherwise website enquiries
# are saved to a database the CRM never shows.
CRM_BACKEND_URL=https://newadminpanelbackendrender26.onrender.com

# ── MongoDB (blog / website-side data) ──
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nncwebsite?retryWrites=true&w=majority

# ── Google reCAPTCHA v2 (optional) ──
# The checkbox is currently disabled site-wide in src/utils/formSpamProtection.js
# (CAPTCHA_DISABLED). Leaving these blank is fine; forms still work.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
